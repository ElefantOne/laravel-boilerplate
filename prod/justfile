set dotenv-path := "prod-frontend.env"

engine := env_var_or_default("CONTAINER_ENGINE", "podman")
compose := if engine == "docker" { "docker compose" } else { "podman-compose" }

pull:
    - {{engine}} pull ghcr.io/kividbio/kividb:v1.1.0-lua
    - {{engine}} pull docker.io/library/caddy:2.10-alpine
    - {{engine}} pull docker.io/rustfs/rustfs:latest

build:
    - cp -r ../apps .
    - cp -r ./rr/rr apps/frontend
    - {{engine}} build --force-rm --build-arg CADDY_ARCH=amd64 --tag laravel_app_prod:1.0 .
    - {{engine}} image prune -f
    - rm -rf ./apps

up:
    - {{compose}} up -d

down:
    - {{compose}} down

migrate:
    - {{engine}} exec -it apps_prod php artisan migrate

console:
    - {{engine}} exec -it apps_prod sh

logs:
    - {{compose}} logs -f

lint:
    - {{engine}} run --rm -i docker.io/hadolint/hadolint < Dockerfile

fmt: pull
    - {{engine}} run --rm -v "$PWD:/code" -i caddy:2.10-alpine caddy validate --config /code/Caddyfile
    - {{engine}} run --rm -v "$PWD:/code" -i caddy:2.10-alpine caddy fmt --overwrite /code/Caddyfile
    - just --fmt --unstable
    - dockerfmt --write Containerfile
