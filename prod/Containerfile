FROM docker.io/library/php:8.5.12-cli-alpine3.24

ARG CADDY_ARCH

ENV XDG_DATA_HOME=/tmp/
ENV XDG_CONFIG_HOME=/tmp/

ADD --chmod=0755 https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/

WORKDIR /tmp

RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" && \
    php composer-setup.php && \
    php -r "unlink('composer-setup.php');" && \
    mv composer.phar /usr/bin/composer && \
    apk --update --no-cache add wget git linux-headers build-base autoconf zeromq-dev zlib-dev && \
    install-php-extensions pcntl bcmath sockets protobuf excimer redis

COPY . .

WORKDIR /app

# hadolint ignore=DL3003
RUN git clone -b issue-php85 https://github.com/remicollet/php-zmq.git \
    && cd php-zmq \
    && phpize \
    && ./configure \
    && make \
    && make install \
    && cd /app \
    && rm -rf php-zmq \
    && wget -q https://github.com/caddyserver/caddy/releases/download/v2.11.7/caddy_2.11.7_linux_$CADDY_ARCH.tar.gz \
    && tar xzf caddy_2.11.7_linux_$CADDY_ARCH.tar.gz \
    && rm caddy_2.11.7_linux_$CADDY_ARCH.tar.gz LICENSE README.md \
    && cd /tmp \
    && mv /tmp/Caddyfile /app \
    && mv /tmp/apps/frontend /app \
    && mv prod-frontend.env /app/frontend/.env \
    && cp ./custom.ini /usr/local/etc/php/conf.d/custom.ini \
    && rm -rf apps php /app/frontend/node_modules \
    && cd /app/frontend \
    && composer install --prefer-dist --optimize-autoloader --no-dev \
    && php artisan key:generate \
    && php artisan optimize \
    && php artisan view:cache \
    && php artisan route:cache \
    && php artisan config:cache \
    && composer clear-cache \
    && chown -R daemon:daemon /app

WORKDIR /app/frontend

USER daemon