engine := env_var_or_default("CONTAINER_ENGINE", "podman")

build-local:
    - go build -o go_hello ./main.go

build:
    - {{engine}} build --tag go_hello:1.0 .

lint:
    - {{engine}} run --rm -i docker.io/hadolint/hadolint < Containerfile

fmt:
    - just --fmt --unstable
    - dockerfmt --write Containerfile
